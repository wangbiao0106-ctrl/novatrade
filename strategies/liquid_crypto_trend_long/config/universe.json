{
  "strategy": "liquid_crypto_trend_long",
  "version": "1.0.0",
  "classification": {
    "source": "OKX public instruments metadata captured with the 5m export window",
    "rule": "instCategory == \"1\" is crypto; \"3\" is tokenised equity/ETF/index; \"4\" is commodity",
    "stablecoins_excluded": true,
    "mainstream_included": true,
    "note": "主流币包含在可交易范围内（策略是纯多头，不做空大市值）。exclude 是生成数据快照时的静态副本，用于复现，不是运行时绑定名单。",
    "false_positive_note": "规范排除清单里的 STABLE 经本地价格核验为加密代币（0.02~0.03 USDT，区间波动约 40%），不是稳定币，因此未排除。"
  },
