{
  "strategy_id": "codex_ai_decision",
  "version": "1.5",
  "source_of_truth": "strategies/codex_ai_decision/STRATEGY.md",
  "display_name": "Codex AI 决策策略",
  "name_en": "Codex AI Decision",
  "provider": "codex",
  "lifecycle": "candidate",
  "runtime_integration": {
    "strategy_id": "codex",
    "runtime_handler": "backend.ai_worker.CodexRunner",
    "decision_endpoint": "/api/v1/ai/strategies/codex",
    "workflow": "single",
    "event_prefilter_default": "off",
    "event_fingerprint": "market-facts-v2",
    "enabled_by_default": false,
    "live_gate": "manual_enable_and_live_trading_switch"
  },
  "model_route": {
    "provider": "codex",
    "model": "gpt-6-luna",
    "reasoning_effort": "medium"
  },
  "signal_parameters": {
    "minimum_confidence": 0.65,
    "decision_interval_seconds": 600,
    "cli_timeout_seconds": 90,
    "snapshot_max_age_seconds": 90,
    "max_output_bytes": 1000000,
    "max_consecutive_failures": 3,
    "max_daily_orders": 20,
    "max_daily_losses": 5,
    "margin_per_order_usd": 500,
    "max_leverage": 5,
    "stop_loss_cooldown_seconds": 14400,
    "recent_stop_loss_window_seconds": 3600,
    "recent_stop_loss_limit": 2
  },
  "entry_analysis": {
    "primary_interval": "15m",
    "minimum_confirmed_candles": 1,
    "directions": [
      "long",
      "short"
    ],
    "auxiliary_intervals": [
      "5m",
      "1H",
      "4H"
    ],
    "forming_candle_role": "context_only",
    "direction_policy": "ai_holistic_no_4h_gate"
  },
  "entry_quality": {
    "minimum_win_rate": 0.5,
    "minimum_risk_reward_ratio": 2.2
  },
  "entry_execution": {
    "order_type": "limit",
    "exchange_order_type": "post_only"
  },
  "entry_preflight": {
    "max_quote_age_seconds": 5,
    "max_future_skew_seconds": 1,
    "max_spread_bps": 10,
    "fee_rate_per_side": 0.0005,
    "slippage_bps": 2,
    "minimum_net_risk_reward_ratio": 2.2
  },
  "risk_policy": {
    "allow_open": true,
    "allow_close": true,
    "allow_cancel": true,
    "require_stop_loss": true,
    "account_daily_loss_percent": 5.0,
    "account_data_unknown": "fail_closed",
    "order_gateway": "shared_durable_ledger"
  },
  "market_context": {
    "optional": true,
    "derivatives_scope": "OKX contract OI; currency-wide Rubik 5m ratios and flow",
    "sentiment_source": "https://api.alternative.me/fng/?limit=1",
    "fed_source": "https://www.federalreserve.gov/feeds/press_monetary.xml",
    "global_cache_seconds": 600,
    "sentiment_max_age_seconds": 172800,
    "derivatives_max_age_seconds": 1800,
    "collection_timeout_seconds": 18
  }
}
