# Local API authentication. Keep this different from exchange credentials.
NOVATRADE_AUTH_TOKEN=replace-with-a-random-local-token
NOVATRADE_STATE_DIR=/Users/you/Library/Application Support/NovaTrade

# Paper trading reads production public quotes and matches locally.
# It needs no OKX credentials. AI execution uses paper-active in this mode.
NOVATRADE_TRADING_MODE=paper
NOVATRADE_PAPER_INITIAL_USDT=5000

# OKX v5 private REST credentials for exchange demo/live modes only.
# Never commit a real value. OKX_DEMO affects private exchange requests.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_DEMO=0
OKX_PROFILE=python-fastapi
OKX_SITE=global

# Exchange simulated trading: NOVATRADE_TRADING_MODE=exchange and OKX_DEMO=1.
# Live trading: NOVATRADE_TRADING_MODE=exchange and OKX_DEMO=0; manual enablement
# is still required before live AI or manual orders can be submitted.

# Optional Codex CLI executable. The worker invokes it in a temporary,
# read-only directory and never passes OKX credentials to the child process.
# NOVATRADE_CODEX_BIN=/Users/you/.local/node-v24/bin/codex

# Optional endpoint overrides for regional or test environments.
# OKX_REST_URL=https://www.okx.com/api/v5
# OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/business
